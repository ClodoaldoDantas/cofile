---
import { menu } from '@/constants/menu'
---

<nav class="desktop-nav" aria-label="Header navigation">
  <ul class="desktop-nav-list">
    {
      menu.map((menuItem) => (
        <li class="desktop-nav-item">
          <a href={menuItem.href} class="nav-link">
            {menuItem.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .desktop-nav {
    display: block;

    @media (width < 768px) {
      display: none;
    }
  }

  .desktop-nav-list {
    display: flex;
    align-items: center;
  }

  .desktop-nav-item {
    a {
      padding: 1rem;
    }
  }
</style>
