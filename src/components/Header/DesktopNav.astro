---
import { menu } from '@/constants/menu'
import Button from '@/components/Button.astro'
---

<nav class="desktop-nav" aria-label="Header navigation">
  <ul class="desktop-nav-list">
    {
      menu.map((menuItem) => (
        <li class="desktop-nav-item">
          <a href={menuItem.href} class="nav-link">
            {menuItem.label}
          </a>
        </li>
      ))
    }

    <li>
      <Button>Download</Button>
    </li>
  </ul>
</nav>

<style>
  .desktop-nav {
    display: block;

    @media (width < 768px) {
      display: none;
    }
  }

  .desktop-nav-list {
    display: flex;
    align-items: center;

    li:last-child {
      margin-left: 0.5rem;
    }
  }

  .desktop-nav-item {
    a {
      padding: 1rem;
    }
  }
</style>
