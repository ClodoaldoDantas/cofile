---
import { menu } from '@/constants/menu'
---

<nav
  class="mobile-nav"
  x-show="open"
  x-transition
  @click.outside="open = false"
  aria-label="Header navigation"
>
  <ul class="mobile-nav-list">
    {
      menu.map((menuItem) => (
        <li class="mobile-nav-item">
          <a href={menuItem.href} class="nav-link">
            {menuItem.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .mobile-nav {
    display: none;
    width: 100%;

    @media (width < 768px) {
      display: block;
    }
  }

  .mobile-nav-item {
    width: 100%;

    & + & {
      border-top: 1px solid #ddd;
    }

    a {
      width: 100%;
      padding: 1rem 1.25rem;
    }
  }
</style>
