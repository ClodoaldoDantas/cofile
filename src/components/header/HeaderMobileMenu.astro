---
import type { MenuItem } from '@/types/menu-item'

interface Props {
  items: MenuItem[]
}

const { items } = Astro.props
---

<nav
  class="mobile-nav"
  x-show="open"
  x-transition
  @click.outside="open = false"
  aria-label="Header navigation"
>
  <ul class="mobile-nav-list">
    {
      items.map((menuItem) => (
        <li class="mobile-nav-item">
          <a href={menuItem.href} class="nav-link">
            {menuItem.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .mobile-nav {
    display: none;

    @media (width < 768px) {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: block;
      background-color: var(--color-white);
      box-shadow: 0 4px 8px -2px rgb(0 0 0 / 7%);
    }
  }

  .mobile-nav-item {
    width: 100%;

    & + & {
      border-top: 1px solid #ddd;
    }

    a {
      width: 100%;
      padding: 0.875rem 1.25rem;
    }
  }
</style>
