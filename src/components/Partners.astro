---
import Container from '@/components/ui/Container.astro'
import Heading from '@/components/ui/Heading.astro'

interface Props {
  images: {
    source: string
    alt: string
  }[]
}

const { images } = Astro.props
---

<section class="partners">
  <Container>
    <Heading title="Trusted by" level={3} />

    <div class="grid">
      {images.map((image) => <img src={image.source} alt={image.alt} />)}
    </div>
  </Container>
</section>

<style>
  .partners {
    padding-bottom: 6rem;
  }

  .grid {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
</style>
