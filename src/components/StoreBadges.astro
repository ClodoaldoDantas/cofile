---
import appStoreBadge from '@/assets/app-store.png'
import googlePlayBadge from '@/assets/google-play.png'

interface Props {
  inline?: boolean
}

const { inline = false } = Astro.props
---

<div class:list={['store-badges', { 'store-badges--inline': inline }]}>
  <a
    href="https://apps.apple.com"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Download on the App Store"
  >
    <img src={appStoreBadge.src} alt="Download on the App Store" />
  </a>

  <a
    href="https://play.google.com"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Get it on Google Play"
  >
    <img src={googlePlayBadge.src} alt="Get it on Google Play" />
  </a>
</div>

<style>
  .store-badges {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .store-badges--inline {
    flex-direction: row;
    align-items: center;
  }
</style>
