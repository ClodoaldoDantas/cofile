---
export interface Props {
  title: string
  level: 1 | 2
}

const { title, level } = Astro.props
---

{
  level === 1 ? (
    <h1 class="heading-lg">{title}</h1>
  ) : (
    <h2 class="heading-md">{title}</h2>
  )
}

<style>
  .heading-md,
  .heading-lg {
    font-weight: 700;
    color: var(--color-neutral-950);
    line-height: 1.3;
  }

  .heading-md {
    font-size: 1.75rem;
  }

  .heading-lg {
    font-size: 2.25rem;
  }
</style>
