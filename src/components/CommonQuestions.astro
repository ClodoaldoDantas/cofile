---
import { Icon } from 'astro-icon/components'
import Container from '@/components/ui/Container.astro'
import Heading from '@/components/ui/Heading.astro'
import Accordion from '@/components/ui/Accordion.astro'
import type { Question } from '@/schemas'

interface Props {
  faq: {
    id: string
    data: Question
  }[]
}

const { faq } = Astro.props

const items = faq.map((question) => ({
  title: question.data.title,
  content: question.data.content,
}))
---

<section
  class="common-questions reveal"
  x-data="{ shown: false }"
  x-intersect.once="shown = true"
  :class="{ 'is-visible': shown }"
>
  <Container class="common-questions-container">
    <div class="common-questions-header">
      <Icon name="ph:seal-question" size={48} aria-hidden="true" />
      <Heading title="Frequently Asked Questions" />
    </div>

    <div class="common-questions-list">
      <Accordion items={items} />
    </div>
  </Container>
</section>

<style>
  .common-questions {
    padding-bottom: 6rem;
  }

  .common-questions-container {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 3rem;

    @media (width < 768px) {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .common-questions-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 20rem;
    flex-shrink: 0;

    @media (width < 768px) {
      max-width: 100%;
    }
  }

  .common-questions-header > svg {
    color: var(--color-primary);
  }

  .common-questions-list {
    width: 100%;
  }
</style>
