---
import Container from '@/components/ui/Container.astro'
import InfoBlock from '@/components/InfoBlock.astro'
import type { Feature } from '@/schemas'

interface Props {
  features: {
    id: string
    data: Feature
  }[]
}

const { features } = Astro.props
---

<section
  class="features reveal"
  x-data="{ shown: false }"
  x-intersect.once="shown = true"
  :class="{ 'is-visible': shown }"
>
  <Container class="features-container">
    {
      features.map((feature) => (
        <InfoBlock
          icon={feature.data.icon}
          title={feature.data.title}
          description={feature.data.description}
        />
      ))
    }
  </Container>
</section>

<style>
  .features {
    padding-bottom: 6rem;
  }

  .features-container {
    margin-block: 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16.875rem, 1fr));
    gap: 2.5rem;
  }
</style>
