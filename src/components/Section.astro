---
import Container from '@/components/Container.astro'
import Heading from '@/components/Heading.astro'
import type { HTMLAttributes } from 'astro/types'

export interface Props extends HTMLAttributes<'section'> {
  title: string
  titleLevel?: 1 | 2
  description: string
  image: {
    mobile: string
    desktop: string
    alt: string
  }
}

const {
  title,
  titleLevel = 2,
  description,
  image,
  class: className,
  ...rest
} = Astro.props
---

<section class:list={['section', className]} {...rest}>
  <Container class="section-container">
    <div class="section-content">
      <Heading title={title} level={titleLevel} />
      <p class="text">{description}</p>
    </div>

    <picture class="section-image">
      <source media="(min-width: 768px)" srcset={image.desktop} />
      <img src={image.mobile} alt={image.alt} />
    </picture>
  </Container>
</section>

<style>
  .section {
    padding-bottom: 6rem;
  }

  .section-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;

    @media (width < 768px) {
      flex-direction: column;
    }
  }

  .section-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 18.75rem;

    @media (width < 768px) {
      max-width: 100%;
    }
  }

  .section-image {
    flex-shrink: 0;
  }
</style>
