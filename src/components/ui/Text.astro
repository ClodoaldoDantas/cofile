---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'p'> {
  text: string
}

const { text, class: className, ...rest } = Astro.props
---

<p class:list={['text', className]} {...rest}>
  {text}
</p>

<style>
  .text {
    font-size: 1rem;
    color: var(--color-neutral-400);
  }
</style>
