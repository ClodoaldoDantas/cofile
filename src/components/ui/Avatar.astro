---
import { Icon } from 'astro-icon/components'

interface Props {
  src?: string | null
  alt?: string | null
}

const props = Astro.props
---

<div class="avatar">
  {
    props.src ? (
      <img
        src={props.src}
        alt={props.alt ?? ''}
        loading="lazy"
        height={96}
        width={96}
      />
    ) : (
      <Icon name="ph:user" size={36} aria-hidden="true" />
    )
  }
</div>

<style>
  .avatar {
    height: 6rem;
    width: 6rem;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #e9e7e7;
    color: var(--color-neutral-950);
  }

  .avatar img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }
</style>
