---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'picture'> {
  mobile: string
  desktop: string
  alt: string
}

const { mobile, desktop, alt, class: className, ...rest } = Astro.props
---

<picture class:list={['picture', className]} {...rest}>
  <source media="(min-width: 768px)" srcset={desktop} />
  <img src={mobile} alt={alt} />
</picture>
