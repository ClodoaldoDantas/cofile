---
import { getCollection } from 'astro:content'

import Layout from '@/layouts/Layout.astro'
import Section from '@/components/ui/Section.astro'
import SectionContent from '@/components/ui/SectionContent.astro'
import SectionBanner from '@/components/ui/SectionBanner.astro'
import Heading from '@/components/ui/Heading.astro'
import Text from '@/components/ui/Text.astro'
import Picture from '@/components/ui/Picture.astro'
import StoreBadges from '@/components/StoreBadges.astro'
import Partners from '@/components/Partners.astro'
import Features from '@/components/Features.astro'
import Testimonials from '@/components/Testimonials.astro'
import CommonQuestions from '@/components/CommonQuestions.astro'

import heroMobile from '@/assets/hero-mobile.png'
import heroDesktop from '@/assets/hero-desktop.png'
import section3Mobile from '@/assets/section-3-mobile.png'
import section3Desktop from '@/assets/section-3-desktop.png'
import section4Mobile from '@/assets/section-4-mobile.png'
import section4Desktop from '@/assets/section-4-desktop.png'
import section8Mobile from '@/assets/section-8-mobile.png'
import section8Desktop from '@/assets/section-8-desktop.png'

import { partners } from '@/constants/partners'

const features = await getCollection('features')
const faq = await getCollection('faq')
const testimonials = await getCollection('testimonials')
---

<Layout title="Cofile" description="Check currency exchange rate in real time">
  <Section class="hero">
    <SectionContent>
      <Heading title="Check Currency Exchange Rate in Real Time" level={1} />
      <Text text="Monitor your worldwide business with this handy apps" />

      <div class="store-badges-container">
        <StoreBadges />
      </div>
    </SectionContent>

    <SectionBanner>
      <Picture
        mobile={heroMobile.src}
        desktop={heroDesktop.src}
        alt="Mobile device showing app with currency exchange rate information"
      />
    </SectionBanner>
  </Section>

  <Partners images={partners} />

  <Section>
    <SectionContent>
      <Heading title="Easy to Use" />
      <Text
        text="Our clean and intuitive design will help you operate the apps easily"
      />
    </SectionContent>

    <SectionBanner>
      <Picture
        mobile={section3Mobile.src}
        desktop={section3Desktop.src}
        alt="Mobile device showing app with currency exchange rate information"
      />
    </SectionBanner>
  </Section>

  <Section>
    <SectionContent inverted>
      <Heading title="Upgrade When You Need" />
      <Text
        text="We committed to provide the free plan forever. Once you need an upgrade, we will be there for you"
      />
    </SectionContent>

    <SectionBanner>
      <Picture
        mobile={section4Mobile.src}
        desktop={section4Desktop.src}
        alt="Mobile device showing app with currency exchange rate information"
      />
    </SectionBanner>
  </Section>

  <Features features={features} />

  <Testimonials testimonials={testimonials} />

  <CommonQuestions faq={faq} />

  <Section>
    <SectionContent>
      <Heading title="Get it Now" />
      <Text text="Monitor your worldwide business with this handy apps" />

      <div class="store-badges-container">
        <StoreBadges />
      </div>
    </SectionContent>

    <SectionBanner>
      <Picture
        mobile={section8Mobile.src}
        desktop={section8Desktop.src}
        alt="Mobile device showing app with currency exchange rate information"
      />
    </SectionBanner>
  </Section>
</Layout>

<style>
  .hero {
    padding-top: 3rem;
  }

  .store-badges-container {
    margin-top: 2.5rem;
  }
</style>
