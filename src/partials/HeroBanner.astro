---
import heroMobile from '@/assets/hero-mobile.png'
import heroDesktop from '@/assets/hero-desktop.png'
---

<section class="hero-banner">
  <div class="container hero-banner-container">
    <div class="hero-banner-content">
      <h1 class="heading-lg hero-banner-title">
        Check Currency Exchange Rate in Real Time
      </h1>

      <p class="text hero-banner-description">
        Monitor your worldwide business with this handy apps
      </p>
    </div>

    <picture class="hero-banner-image">
      <source media="(min-width: 768px)" srcset={heroDesktop.src} />
      <img
        src={heroMobile.src}
        alt="Currency exchange rate app shown on a mobile device"
      />
    </picture>
  </div>
</section>

<style>
  .hero-banner {
    padding-top: 3rem;
    padding-bottom: 6rem;

    @media (width < 768px) {
      padding-top: 4rem;
    }
  }

  .container {
    width: min(100%, 58.75rem);
    margin: 0 auto;
    padding: 0 1rem;
  }

  .hero-banner-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;

    @media (width < 768px) {
      flex-direction: column;
    }
  }

  .hero-banner-title,
  .hero-banner-description {
    max-width: 18.75rem;

    @media (width < 768px) {
      max-width: 100%;
    }
  }

  .hero-banner-description {
    margin-top: 0.5rem;
  }

  .hero-banner-image {
    flex-shrink: 0;
  }
</style>
